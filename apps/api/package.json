{
  "name": "@mailtracker/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/fixtures',{recursive:true});fs.copyFileSync('src/fixtures/inbox.json','dist/fixtures/inbox.json')\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "prisma generate && tsc -p tsconfig.build.json --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@mailtracker/shared": "file:../../packages/shared",
    "@prisma/client": "^6.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "firebase-admin": "^13.2.0",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.1.0",
    "jose": "^5.9.6",
    "p-limit": "^6.2.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "@types/pg": "^8.11.10",
    "eslint": "^9.25.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0"
  }
}
